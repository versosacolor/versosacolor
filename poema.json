{
  "titulo": "Escrito con alma",
  "firma": "— Versos a Color 🌈",
  "versos": [
    "Mi lugar favorito,",
    "mi comunicación espacio,",
    "mi chica favorita,",
    "mi lugar de escritura.",
    "",
    "Aquí cada verso nace",
    "de lo más hondo del corazón,",
    "donde el color y la palabra",
    "se convierten en canción.",
    "",
    "Te dedico estas líneas",
    "pintadas con arcoíris y amor,",
    "porque eres tú mi inspiración,",
    "mi musa, mi mejor color."
  ]
}
